# Server port (hosting providers like Render/Railway set this automatically)
PORT=8787

# MongoDB database name
DB_NAME=inventory

# MongoDB Atlas connection string (URL-encode special characters in username/password, no whitespace)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_secure_admin_password

# JWT secret key (MUST be at least 32 characters long)
JWT_SECRET=replace_with_a_secure_random_key_at_least_32_chars_long

# 6-digit numeric access PIN (MUST be exactly 6 numeric digits: 0-9)
ACCESS_PIN=replace_with_a_unique_6_digit_access_pin

# Allowed frontend origin (e.g., https://your-app.vercel.app in production or http://localhost:5173 for local dev)
FRONTEND_ORIGIN=http://localhost:5173

# Node environment: 'development' or 'production'
NODE_ENV=production
